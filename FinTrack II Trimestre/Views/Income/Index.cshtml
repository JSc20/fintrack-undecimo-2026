@model IEnumerable<FinTrack_II_Trimestre.Models.Income>

@{
    ViewData["Title"] = "Ingresos";
    Layout = null;
    var totalIngresos = Model?.Sum(i => i.IncomeAmount) ?? 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ingresos - FinTrack</title>
    <!-- Chart.js para el gráfico circular -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-dark: #0b0f1a;
            --bg-panel: #101828;
            --bg-card: #1a2436;
            --bg-card-2: #16202f;
            --border-color: #253147;
            --text-primary: #e8ecf3;
            --text-secondary: #8b95a7;
            --text-muted: #6b7484;
            --accent-blue: #2b4a7a;
            --accent-green: #3ecf6e;
            --accent-red: #e0453f;
            --sidebar-active: #1e3a8a33;
            --sidebar-active-border: #3b5fd9;
            --input-bg: linear-gradient(90deg, #e9ecf1, #c7ccd6);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .topbar {
            background-color: #05070c;
            color: var(--text-muted);
            font-size: 0.8rem;
            padding: 8px 20px;
        }

        .app-layout {
            display: flex;
            min-height: calc(100vh - 34px);
        }

        /* ---------- SIDEBAR ---------- */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: var(--bg-panel);
            display: flex;
            flex-direction: column;
            padding: 20px 16px;
            border-right: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #3ecf6e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .brand-toggle { margin-left: auto; color: var(--text-muted); font-size: 0.9rem; }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        .search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 0.85rem;
            width: 100%;
        }

        .sidebar hr {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 8px 0 14px;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .nav-list li a {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-secondary);
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: background-color 0.15s ease;
        }

        .nav-list li a:hover { background-color: #16202f; color: var(--text-primary); }

        .nav-list li a.active {
            background-color: var(--sidebar-active);
            border-left: 3px solid var(--sidebar-active-border);
            color: var(--text-primary);
            font-weight: 600;
        }

        .nav-icon { width: 18px; text-align: center; }

        .sidebar-settings { margin-top: 10px; }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--bg-card);
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: 16px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #2b4a7a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-card .user-info { display: flex; flex-direction: column; line-height: 1.2; }
        .user-card .user-info small { color: var(--text-muted); font-size: 0.75rem; }
        .user-card .chevron { margin-left: auto; color: var(--text-muted); }

        /* ---------- MAIN CONTENT ---------- */
        .main-content {
            flex-grow: 1;
            padding: 28px 32px;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .page-header h1 { font-size: 1.6rem; font-weight: 700; }
        .page-header p { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }

        /* ---------- METRIC CARDS TOP BAR ---------- */
        .metrics-row {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .metric-card {
            flex: 1;
            min-width: 140px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 12px 16px;
            text-align: center;
        }

        .metric-card .label { color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 6px; }
        .metric-card .value { font-size: 1.15rem; font-weight: 700; }

        .val-green { color: var(--accent-green); }
        .val-red { color: var(--accent-red); }

        /* ---------- GRID DE 2 COLUMNAS (LISTA + GRÁFICO) ---------- */
        .dashboard-grid {
            display: flex;
            gap: 20px;
            flex-grow: 1;
        }

        .panel-box {
            flex: 1;
            background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-card-2) 100%);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            display: flex;
            flex-direction: column;
        }

        .panel-title {
            text-align: center;
            color: var(--text-secondary);
            font-size: 1rem;
            margin-bottom: 12px;
            font-weight: 600;
        }

        .panel-divider {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 0 auto 20px auto;
            width: 80%;
        }

        .alert-success {
            background-color: rgba(62, 207, 110, 0.15);
            border: 1px solid var(--accent-green);
            color: var(--accent-green);
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 16px;
            text-align: center;
        }

        /* TABLA DE INGRESOS (ESTILO COMPACTO CON EDITAR) */
        .income-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            flex-grow: 1;
            overflow-y: auto;
        }

        .income-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-radius: 6px;
            transition: background-color 0.15s ease;
        }

        .income-row:hover {
            background-color: rgba(255, 255, 255, 0.03);
        }

        .income-name {
            font-size: 0.95rem;
            font-weight: 500;
        }

        .income-details {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .income-amount {
            font-size: 0.95rem;
            font-weight: 600;
        }

        .btn-edit-icon {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.15s ease;
        }

        .btn-edit-icon:hover {
            color: var(--text-primary);
        }

        .income-total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.25);
            padding: 14px 16px;
            border-radius: 8px;
            margin-top: 15px;
            font-weight: 700;
            font-size: 1rem;
        }

        /* GRÁFICO CIRCULAR */
        .chart-container {
            position: relative;
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            max-height: 280px;
        }

        /* ---------- BOTONES DE ACCIÓN ---------- */
        .actions-row {
            display: flex;
            gap: 16px;
            margin-top: 5px;
        }

        .btn {
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
            border-radius: 24px;
            padding: 10px 24px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            color: #fff;
            background-color: var(--accent-green);
            text-decoration: none;
            transition: filter 0.15s ease;
        }

        .btn:hover { filter: brightness(1.15); }

        .btn-eliminar {
            background-color: var(--accent-red);
            color: #fff;
        }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 900px) {
            .dashboard-grid {
                flex-direction: column;
            }
        }

        @@media (max-width: 768px) {
            .app-layout { flex-direction: column; }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }

            .main-content { padding: 20px 16px; }

            .actions-row { flex-direction: column; width: 100%; }
            .actions-row .btn { justify-content: center; width: 100%; }
        }
    </style>
</head>
<body>
    <div class="topbar">Ingresos</div>

    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">🐱</div>
                <span>FinTrack</span>
                <span class="brand-toggle">&lt;&gt;</span>
            </div>

            <div class="search-box">
                <span>🔍</span>
                <input type="text" placeholder="Buscar..." />
            </div>

            <hr />

            <ul class="nav-list">
                <li><a href="@Url.Action("Index", "Home")"><span class="nav-icon">🏠</span> Home</a></li>
                <li><a href="@Url.Action("Index", "User")"><span class="nav-icon">👤</span> Usuario</a></li>
                <li><a href="@Url.Action("Index", "BudgetPlan")"><span class="nav-icon">📋</span> Plan de Gestion</a></li>
                <li><a href="#"><span class="nav-icon">🏷️</span> Categorias</a></li>
                <li><a href="#"><span class="nav-icon">🏦</span> Ahorros</a></li>
                <li><a href="@Url.Action("Index", "Income")" class="active"><span class="nav-icon">➕</span> Ingresos</a></li>
                <li><a href="@Url.Action("Index", "Expense")"><span class="nav-icon">➖</span> Egresos</a></li>
            </ul>

            <hr />

            <ul class="nav-list sidebar-settings">
                <li><a href="#"><span class="nav-icon">⚙️</span> Settings</a></li>
            </ul>

            <div class="user-card">
                <div class="user-avatar">👤</div>
                <div class="user-info">
                    <span>Usuario</span>
                    <small>30x30x60</small>
                </div>
                <span class="chevron">›</span>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="page-header">
                <h1>Ingresos</h1>
                <p>Gestiona todos tus ingresos</p>
            </div>

            <!-- CARDS DE MÉTRICAS -->
            <div class="metrics-row">
                <div class="metric-card">
                    <div class="label">Ingresos</div>
                    <div class="value val-green">
                        $@(((decimal)(ViewBag.TotalIngresosMes ?? 0)).ToString("N0"))/Mes
                    </div>
                </div>
                <div class="metric-card">
                    <div class="label">Egresos</div>
                    <div class="value val-red">$1.450/Mes</div>
                </div>
                <div class="metric-card">
                    <div class="label">Plan</div>
                    <div class="value">30x30x60</div>
                </div>
                <div class="metric-card">
                    <div class="label"># Egresos</div>
                    <div class="value">5</div>
                </div>
                <div class="metric-card">
                    <div class="label">Ahorro</div>
                    <div class="value val-green">$12.500</div>
                </div>
            </div>

            <!-- DASHBOARD GRID: LISTA + GRÁFICO -->
            <div class="dashboard-grid">
                
                <!-- COLUMNA IZQUIERDA: LISTA -->
                <div class="panel-box">
                    <div class="panel-title">Ingresos</div>
                    <hr class="panel-divider" />

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <div class="income-list">
                        @if (!Model.Any())
                        {
                            <div style="text-align: center; color: var(--text-muted); padding: 20px;">
                                No hay ingresos registrados.
                            </div>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <div class="income-row">
                                    <span class="income-name">@item.IncomeType</span>
                                    <div class="income-details">
                                        <span class="income-amount">@item.IncomeAmount.ToString("N0")</span>
                                        <a href="@Url.Action("Edit", "Income", new { id = item.IncomeId })" class="btn-edit-icon" title="Editar">✏️</a>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="income-total-row">
                        <span>Total</span>
                        <span>@totalIngresos.ToString("N0")</span>
                    </div>
                </div>

                <!-- COLUMNA DERECHA: GRÁFICO CIRCULAR -->
                <div class="panel-box">
                    <div class="panel-title">Ingresos</div>
                    <hr class="panel-divider" />
                    
                    <div class="chart-container">
                        <canvas id="incomePieChart"></canvas>
                    </div>
                </div>

            </div>

            <!-- BOTONES DE ACCIÓN -->
            <div class="actions-row">
                <a class="btn" href="@Url.Action("Create", "Income")">➕ Agregar Ingreso</a>
                <a class="btn btn-eliminar" href="#">❌ Eliminar Ingreso</a>
            </div>
        </main>
    </div>

    <!-- Script para renderizar el gráfico dinámicamente -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('incomePieChart').getContext('2d');

            // Extraer datos desde Razor Model
            const labels = [
                @Html.Raw(string.Join(",", Model.Select(m => $"'{m.IncomeType}'")))
            ];
            const data = [
                @Html.Raw(string.Join(",", Model.Select(m => m.IncomeAmount)))
            ];

            // Colores por defecto si no hay datos
            const chartLabels = labels.length > 0 ? labels : ['Sin datos'];
            const chartData = data.length > 0 ? data : [1];
            const colors = ['#ff5964', '#ffbc42', '#8ac926', '#1982c4', '#6a4c93', '#f15bb5'];

            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        data: chartData,
                        backgroundColor: colors.slice(0, chartLabels.length),
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false // Oculta la leyenda superior para coincidir con la UI
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    let label = context.label || '';
                                    let value = context.raw || 0;
                                    return `${label}: $${value}`;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>