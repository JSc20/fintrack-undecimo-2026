@model IEnumerable<FinTrack_II_Trimestre.Models.Expense>

@{
    ViewData["Title"] = "Egresos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Egresos - FinTrack</title>
    <style>
        :root {
            --bg-dark: #0b0f1a;
            --bg-panel: #101828;
            --bg-card: #1a2436;
            --bg-card-2: #16202f;
            --border-color: #253147;
            --text-primary: #e8ecf3;
            --text-secondary: #8b95a7;
            --text-muted: #6b7484;
            --accent-blue: #2b4a7a;
            --accent-green: #3ecf6e;
            --accent-red: #e0453f;
            --sidebar-active: #1e3a8a33;
            --sidebar-active-border: #3b5fd9;
            --input-bg: linear-gradient(90deg, #e9ecf1, #c7ccd6);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .topbar {
            background-color: #05070c;
            color: var(--text-muted);
            font-size: 0.8rem;
            padding: 8px 20px;
        }

        .app-layout {
            display: flex;
            min-height: calc(100vh - 34px);
        }

        /* ---------- SIDEBAR ---------- */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: var(--bg-panel);
            display: flex;
            flex-direction: column;
            padding: 20px 16px;
            border-right: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #3ecf6e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .brand-toggle { margin-left: auto; color: var(--text-muted); font-size: 0.9rem; }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        .search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 0.85rem;
            width: 100%;
        }

        .sidebar hr {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 8px 0 14px;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .nav-list li a {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-secondary);
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: background-color 0.15s ease;
        }

        .nav-list li a:hover { background-color: #16202f; color: var(--text-primary); }

        .nav-list li a.active {
            background-color: var(--sidebar-active);
            border-left: 3px solid var(--sidebar-active-border);
            color: var(--text-primary);
            font-weight: 600;
        }

        .nav-icon { width: 18px; text-align: center; }

        .sidebar-settings { margin-top: 10px; }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--bg-card);
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: 16px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #2b4a7a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-card .user-info { display: flex; flex-direction: column; line-height: 1.2; }
        .user-card .user-info small { color: var(--text-muted); font-size: 0.75rem; }
        .user-card .chevron { margin-left: auto; color: var(--text-muted); }

        /* ---------- MAIN CONTENT ---------- */
        .main-content {
            flex-grow: 1;
            padding: 28px 32px;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .page-header h1 { font-size: 1.6rem; font-weight: 700; }
        .page-header p { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }

        /* ---------- METRIC CARDS TOP BAR ---------- */
        .metrics-row {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .metric-card {
            flex: 1;
            min-width: 140px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 12px 16px;
            text-align: center;
        }

        .metric-card .label { color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 6px; }
        .metric-card .value { font-size: 1.15rem; font-weight: 700; }

        .val-green { color: var(--accent-green); }
        .val-red { color: var(--accent-red); }

        /* ---------- PANEL DE LISTA / TABLA ---------- */
        .list-panel {
            background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-card-2) 100%);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            min-height: 380px;
            display: flex;
            flex-direction: column;
        }

        .panel-title {
            text-align: center;
            color: var(--text-secondary);
            font-size: 1rem;
            margin-bottom: 12px;
            font-weight: 600;
        }

        .panel-divider {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 0 auto 20px auto;
            width: 60%;
        }

        .alert-success {
            background-color: rgba(62, 207, 110, 0.15);
            border: 1px solid var(--accent-green);
            color: var(--accent-green);
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 16px;
            text-align: center;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            flex-grow: 1;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
            text-align: left;
        }

        .data-table th, .data-table td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
        }

        .data-table th {
            color: var(--text-secondary);
            font-weight: 600;
        }

        .data-table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

        .empty-row {
            text-align: center;
            color: var(--text-muted);
            padding: 30px 0;
        }

        /* ---------- ACCIONES / BOTONES ---------- */
        .actions-row {
            display: flex;
            gap: 14px;
            justify-content: center;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .btn {
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
            border-radius: 24px;
            padding: 10px 24px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            color: #fff;
            background-color: var(--accent-blue);
            text-decoration: none;
            transition: filter 0.15s ease;
        }

        .btn:hover { filter: brightness(1.15); }

        .btn-eliminar {
            background-color: transparent;
            border: 1px solid var(--accent-red);
            color: var(--accent-red);
        }

        .btn-eliminar:hover { background-color: var(--accent-red); color: #fff; }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 768px) {
            .app-layout { flex-direction: column; }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }

            .main-content { padding: 20px 16px; }

            .actions-row { flex-direction: column; width: 100%; }
            .actions-row .btn { justify-content: center; width: 100%; }
        }
    </style>
</head>
<body>
    <div class="topbar">Egresos</div>

    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">🐱</div>
                <span>FinTrack</span>
                <span class="brand-toggle">&lt;&gt;</span>
            </div>

            <div class="search-box">
                <span>🔍</span>
                <input type="text" placeholder="Buscar..." />
            </div>

            <hr />

            <ul class="nav-list">
                <li><a href="@Url.Action("Index", "Home")"><span class="nav-icon">🏠</span> Home</a></li>
                <li><a href="@Url.Action("Index", "User")"><span class="nav-icon">👤</span> Usuario</a></li>
                <li><a href="@Url.Action("Index", "BudgetPlan")"><span class="nav-icon">📋</span> Plan de Gestion</a></li>
                <li><a href="#"><span class="nav-icon">🏷️</span> Categorias</a></li>
                <li><a href="#"><span class="nav-icon">🏦</span> Ahorros</a></li>
                <li><a href="@Url.Action("Index", "Income")"><span class="nav-icon">➕</span> Ingresos</a></li>
                <li><a href="@Url.Action("Index", "Expense")" class="active"><span class="nav-icon">➖</span> Egresos</a></li>
            </ul>

            <hr />

            <ul class="nav-list sidebar-settings">
                <li><a href="#"><span class="nav-icon">⚙️</span> Settings</a></li>
            </ul>

            <div class="user-card">
                <div class="user-avatar">👤</div>
                <div class="user-info">
                    <span>Usuario</span>
                    <small>30x30x60</small>
                </div>
                <span class="chevron">›</span>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="page-header">
                <h1>Egresos</h1>
                <p>Gestiona tus egresos.</p>
            </div>

            <!-- CARDS DE MÉTRICAS -->
            <div class="metrics-row">
                <div class="metric-card">
                    <div class="label">Ingresos</div>
                    <div class="value val-green">$2.400/Mes</div>
                </div>
                <div class="metric-card">
                    <div class="label">Egresos</div>
                    <div class="value val-red">
                        $@(((decimal)(ViewBag.TotalGastosMes ?? 0)).ToString("N2"))/Mes
                    </div>
                </div>
                <div class="metric-card">
                    <div class="label">Plan</div>
                    <div class="value">30x30x60</div>
                </div>
                <div class="metric-card">
                    <div class="label"># Egresos</div>
                    <div class="value">@Model.Count()</div>
                </div>
                <div class="metric-card">
                    <div class="label">Ahorro</div>
                    <div class="value val-green">$12.500</div>
                </div>
            </div>

            <!-- PANEL CENTRAL DE LISTA -->
            <div class="list-panel">
                <div class="panel-title">Lista de Egresos</div>
                <hr class="panel-divider" />

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Monto</th>
                                <th>Fecha</th>
                                <th>Fijo</th>
                                <th>Vencimiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="empty-row">No hay egresos registrados actualmente.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ExpenseName</td>
                                        <td>@(item.Category?.CategoryName ?? "Sin Categoría")</td>
                                        <td class="val-red">-$@item.ExpenseAmount.ToString("N2")</td>
                                        <td>@item.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                        <td>@(item.IsFixed ? "Sí" : "No")</td>
                                        <td>@(item.DueDate.HasValue ? item.DueDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- BOTONES DE ACCIÓN ABAJO -->
            <div class="actions-row">
                <a class="btn" href="@Url.Action("Create", "Expense")">➕ Crear</a>
                <a class="btn" href="#">⚙️ Actualizar</a>
                <a class="btn btn-eliminar" href="#">⚠️ Eliminar</a>
            </div>
        </main>
    </div>
</body>
</html>