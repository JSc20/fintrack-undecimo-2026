@model FinTrack_II_Trimestre.Models.User
@{
    ViewData["Title"] = "Registrarse";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrarse - FinTrack</title>
    <link rel="stylesheet" href="~/css/register.css" />
    <script>
        (function(){var t=localStorage.getItem('ft-theme')||'dark';if(t==='light')document.documentElement.classList.add('light-theme');})();
    </script>
</head>
<body>
    <div class="auth-wrapper">
        <div class="brand" style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; font-weight: 700; font-size: 1.2rem;">
            <img src="~/img/logo.svg" alt="FinTrack Logo" style="width:32px; height:32px;" />
            <span>FinTrack</span>
        </div>

        <div class="auth-card">
            <form class="form-col" method="post" asp-controller="User" asp-action="Register">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="Username">Nombre de Usuario</label>
                    <input asp-for="Username" type="text" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <!-- Estos campos no existen en User.cs, pero se procesan en el backend para crear el Perfil -->
                <div class="form-group">
                    <label for="FullName">Nombre Completo</label>
                    <input name="FullName" id="FullName" type="text" value="@ViewBag.FullName" required />
                </div>

                <div class="form-group">
                    <label for="Age">Edad</label>
                    <input name="Age" id="Age" type="number" value="@ViewBag.Age" required />
                </div>

                <div class="form-group">
                    <label for="Email">Correo Electrónico</label>
                    <input name="Email" id="Email" type="email" value="@ViewBag.Email" required />
                </div>

                <div class="form-group">
                    <label for="Phone">Número de teléfono</label>
                    <input name="Phone" id="Phone" type="tel" value="@ViewBag.Phone" maxlength="8" oninput="this.value = this.value.replace(/[^0-9]/g, '');" required />
                </div>

                <div class="form-group">
                    <label asp-for="Password">Contraseña</label>
                    <input asp-for="Password" type="password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label for="ConfirmPassword">Confirmar Contraseña</label>
                    <input name="ConfirmPassword" id="ConfirmPassword" type="password" required />
                </div>

                <button type="submit" class="btn-primary">Registrarse</button>

                <p class="switch-text">
                    Ya tiene una cuenta? <a href="@Url.Action("Login", "User")">Iniciar sesión</a>
                </p>
            </form>

            <div class="illustration-col">
                <img src="~/img/piggy2.png" alt="Register Piggy Bank" style="width: 100%; max-width: 450px; object-fit: contain; margin-top: -30px; margin-bottom: -30px;" />
            </div>
        </div>
    </div>
</body>
</html>
