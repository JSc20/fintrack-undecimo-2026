@model FinTrack_II_Trimestre.Models.UserLoginModel
@{
    ViewData["Title"] = "Iniciar Sesion";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesion - FinTrack</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <script>
        (function(){var t=localStorage.getItem('ft-theme')||'dark';if(t==='light')document.documentElement.classList.add('light-theme');})();
    </script>
</head>
<body>
    <div class="auth-wrapper">
        <div class="top-row">
            <div class="brand">
                <img src="~/img/logo.svg" alt="FinTrack Logo" style="width:32px; height:32px;" />
                <span>FinTrack</span>
            </div>
        </div>

        <div class="auth-card">
            <form class="form-col" method="post" asp-controller="User" asp-action="Login">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="Username">Usuario</label>
                    <input asp-for="Username" type="text" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Contraseña</label>
                    <input asp-for="Password" type="password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="btn-primary">Iniciar Sesión</button>

                <p class="switch-text">
                    No tiene cuenta? <a href="@Url.Action("Register", "User")">Registrarse</a>
                </p>
            </form>

            <div class="illustration-col">
                <img src="~/img/piggy1.png" alt="Login Piggy Bank" style="width: 100%; max-width: 450px; object-fit: contain; margin-top: -30px; margin-bottom: -30px;" />
            </div>
        </div>
    </div>
</body>
</html>
