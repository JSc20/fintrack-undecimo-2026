@page
@model FinTrack_II_Trimestre.Models.UserLoginModel
@{
    ViewData["Title"] = "Iniciar Sesion";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesion - FinTrack</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', Roboto, Arial, sans-serif;
                background-color: #0b0f1a;
                color: #e8ecf3;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .auth-wrapper {
                width: 100%;
                max-width: 910px;
                background-color: #0d1b2e;
                border-radius: 14px;
                padding: 30px;
            }

            .top-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 700;
                font-size: 1.2rem;
            }

            .brand-icon {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #3ecf6e;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1rem;
            }

            .top-row .title {
                font-weight: 700;
                font-size: 1rem;
            }

            .auth-card {
                background-color: #1c3d63;
                border-radius: 12px;
                padding: 34px 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 30px;
                flex-wrap: wrap;
            }

            .form-col {
                flex: 1 1 320px;
                max-width: 380px;
            }

            .form-group {
                margin-bottom: 18px;
            }

                .form-group label {
                    display: block;
                    font-weight: 600;
                    font-size: 0.92rem;
                    margin-bottom: 6px;
                }

                .form-group input {
                    width: 100%;
                    border: none;
                    border-radius: 6px;
                    padding: 10px 12px;
                    background-color: #c9ccd2;
                    font-size: 0.9rem;
                    color: #222;
                    outline: none;
                }

                    .form-group input:focus {
                        outline: 2px solid #3ecf6e;
                    }

            .btn-primary {
                width: 100%;
                border: none;
                border-radius: 24px;
                padding: 12px;
                margin-top: 6px;
                background-color: #4b7a2f;
                color: #fff;
                font-weight: 700;
                font-size: 1rem;
                cursor: pointer;
            }

                .btn-primary:hover {
                    filter: brightness(1.1);
                }

            .switch-text {
                text-align: center;
                font-size: 0.8rem;
                color: #cfd6e0;
                margin-top: 12px;
            }

                .switch-text a {
                    color: #cfd6e0;
                    font-weight: 700;
                    font-style: italic;
                    text-decoration: none;
                }

                    .switch-text a:hover {
                        text-decoration: underline;
                    }

            .illustration-col {
                flex: 0 0 220px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .illustration-col svg {
                    width: 100%;
                    max-width: 220px;
                    height: auto;
                }

            .validation-summary {
                color: #ff8b85;
                font-size: 0.8rem;
                margin-bottom: 10px;
            }

            .field-error {
                display: block;
                color: #ff8b85;
                font-size: 0.75rem;
                margin-top: 4px;
            }

            @@media (max-width: 700px) {
                .auth-card {
                    flex-direction: column-reverse;
                    padding: 26px 22px;
                }

                .illustration-col {
                    flex: 0 0 auto;
                    max-width: 160px;
                }
            }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="top-row">
            <div class="brand">
                <div class="brand-icon">🐱</div>
                <span>FinTrack</span>
            </div>
            <span class="title">Iniciar Sesion</span>
        </div>

        <div class="auth-card">
            <form class="form-col" method="post" asp-controller="User" asp-action="Login">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="Username">Usuario</label>
                    <input asp-for="Username" type="text" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Contraseña</label>
                    <input asp-for="Password" type="password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="btn-primary">Iniciar Sesión</button>

                <p class="switch-text">
                    No tiene cuenta? <a href="@Url.Action("Register", "User")">Registrarse</a>
                </p>
            </form>

            <div class="illustration-col">
                <svg viewBox="0 0 220 200" xmlns="http://www.w3.org/2000/svg">
                    <ellipse cx="110" cy="115" rx="80" ry="60" fill="#3ecf6e" />
                    <ellipse cx="55" cy="70" rx="18" ry="16" fill="#3ecf6e" />
                    <ellipse cx="150" cy="65" rx="20" ry="18" fill="#3ecf6e" />
                    <circle cx="80" cy="100" r="8" fill="#5a0e0e" />
                    <circle cx="83" cy="97" r="2.5" fill="#fff" />
                    <circle cx="115" cy="100" r="8" fill="#5a0e0e" />
                    <circle cx="118" cy="97" r="2.5" fill="#fff" />
                    <ellipse cx="98" cy="130" rx="22" ry="14" fill="#2fae57" />
                    <circle cx="90" cy="130" r="4" fill="#1c7a3b" />
                    <circle cx="106" cy="130" r="4" fill="#1c7a3b" />
                    <path d="M30 130 Q10 120 15 145 Q25 150 35 140 Z" fill="#3ecf6e" />
                    <path d="M175 130 Q195 120 190 145 Q180 150 170 140 Z" fill="#3ecf6e" />
                    <ellipse cx="150" cy="60" rx="12" ry="16" fill="#f5a623" transform="rotate(-20 150 60)" />
                    <text x="146" y="66" font-size="14" fill="#fff" font-weight="700">c</text>
                </svg>
            </div>
        </div>
    </div>
</body>
</html>
