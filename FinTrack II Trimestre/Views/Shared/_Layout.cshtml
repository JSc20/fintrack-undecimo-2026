<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinTrack</title>
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/layout.css" />
    @await RenderSectionAsync("Styles", required: false)

    <!-- Aplica el tema guardado ANTES de renderizar para evitar flash -->
    <script>
        (function(){var t=localStorage.getItem('ft-theme')||'dark';if(t==='light')document.documentElement.classList.add('light-theme');})();
    </script>
</head>
<body>

    <!-- Botón hamburguesa — solo visible en móvil -->
    <button class="sidebar-toggle-btn" id="sidebar-toggle" aria-label="Abrir menú">
        <i class="bi bi-list"></i>
    </button>

    <!-- Overlay para cerrar sidebar en móvil -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- SIDEBAR -->
    <aside class="ft-sidebar">
        <div class="ft-logo-container">
            <img src="~/img/logo.svg" alt="FinTrack Logo" style="width: 35px; height: 35px;" />
            <h4>FinTrack</h4>
        </div>

        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text" class="ft-search" placeholder="Buscar...">
        </div>

        <ul class="ft-nav-menu">
            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            <li class="ft-nav-item"><a asp-controller="Home" asp-action="Index" class="ft-nav-link @(currentController == "Home" ? "active" : "")"><i class="bi bi-house-door-fill"></i> Home</a></li>
            <li class="ft-nav-item"><a asp-controller="BudgetPlan" asp-action="Index" class="ft-nav-link @(currentController == "BudgetPlan" ? "active" : "")"><i class="bi bi-file-earmark-text-fill"></i> Plan de Gestion</a></li>
            <li class="ft-nav-item">
                <a asp-controller="Category" asp-action="Index" class="ft-nav-link @(currentController == "Category" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i> Categorias @if(currentController == "Category"){ <i class="bi bi-chevron-right ms-auto" style="font-size:0.75rem;"></i> }
                </a>
            </li>
            <li class="ft-nav-item"><a asp-controller="SavingsGoal" asp-action="Index" class="ft-nav-link @(currentController == "SavingsGoal" ? "active" : "")"><i class="bi bi-piggy-bank-fill"></i> Ahorros</a></li>
            <li class="ft-nav-item"><a asp-controller="Income" asp-action="Index" class="ft-nav-link @(currentController == "Income" ? "active" : "")"><i class="bi bi-plus-circle-fill"></i> Ingresos</a></li>
            <li class="ft-nav-item"><a asp-controller="Expense" asp-action="Index" class="ft-nav-link @(currentController == "Expense" ? "active" : "")"><i class="bi bi-dash-circle-fill"></i> Egresos</a></li>

            <li class="ft-nav-divider"></li>

            <!-- Settings se deja con "#" a menos que tengas un controlador específico para ello -->
            <li class="ft-nav-item">
                <button id="theme-toggle-btn" class="ft-nav-link w-100 border-0 bg-transparent text-start" style="cursor:pointer;">
                    <i class="theme-icon bi bi-sun-fill"></i>
                    <span class="theme-label">Modo Claro</span>
                </button>
            </li>
        </ul>

        <!-- Convertido en etiqueta <a> para que lleve al perfil al hacer clic -->
        <a asp-controller="Profile" asp-action="Index" class="ft-user-card">
            <div class="ft-user-avatar"><i class="bi bi-person text-dark fs-5"></i></div>
            <div class="ft-user-info">
                <p class="ft-user-name">@(Context.Session.GetString("Username") ?? "Usuario")</p>
                <p class="ft-user-plan">@(Context.Session.GetString("PlanActual") ?? "Sin plan")</p>
            </div>
            <i class="bi bi-chevron-right ms-auto text-muted" style="font-size:0.8rem;"></i>
        </a>
    </aside>

    <!-- RENDER BODY -->
    <main class="ft-main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>