@page
@model FinTrack_II_Trimestre.Models.ViewModels.CategoryIndexViewModel
@{
    ViewData["Title"] = "Categorias";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categorias - FinTrack</title>
    <style>
        :root {
            --bg-dark: #0b0f1a;
            --bg-panel: #101828;
            --bg-card: #1a2436;
            --bg-card-2: #16202f;
            --border-color: #253147;
            --text-primary: #e8ecf3;
            --text-secondary: #8b95a7;
            --text-muted: #6b7484;
            --accent-blue: #2b4a7a;
            --accent-green: #3ecf6e;
            --accent-red: #e0453f;
            --sidebar-active: #1e3a8a33;
            --sidebar-active-border: #3b5fd9;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .topbar {
            background-color: #05070c;
            color: var(--text-muted);
            font-size: 0.8rem;
            padding: 8px 20px;
        }

        .app-layout {
            display: flex;
            min-height: calc(100vh - 34px);
        }

        /* ---------- SIDEBAR ---------- */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: var(--bg-panel);
            display: flex;
            flex-direction: column;
            padding: 20px 16px;
            border-right: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #3ecf6e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .brand-toggle { margin-left: auto; color: var(--text-muted); font-size: 0.9rem; }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        .search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 0.85rem;
            width: 100%;
        }

        .sidebar hr {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 8px 0 14px;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .nav-list li a {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-secondary);
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: background-color 0.15s ease;
        }

        .nav-list li a:hover { background-color: #16202f; color: var(--text-primary); }

        .nav-list li a.active {
            background-color: var(--sidebar-active);
            border-left: 3px solid var(--sidebar-active-border);
            color: var(--text-primary);
            font-weight: 600;
        }

        .nav-icon { width: 18px; text-align: center; }

        .sidebar-settings { margin-top: 10px; }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--bg-card);
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: 16px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #2b4a7a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-card .user-info { display: flex; flex-direction: column; line-height: 1.2; }
        .user-card .user-info small { color: var(--text-muted); font-size: 0.75rem; }
        .user-card .chevron { margin-left: auto; color: var(--text-muted); }

        /* ---------- MAIN CONTENT ---------- */
        .main-content {
            flex-grow: 1;
            padding: 28px 32px;
            overflow-x: hidden;
        }

        .page-header h1 { font-size: 1.6rem; font-weight: 700; }
        .page-header p { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }

        /* ---------- STAT CARDS ---------- */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin: 24px 0 28px;
        }

        .stat-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px 10px;
            text-align: center;
        }

        .stat-card .label { color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 6px; }
        .stat-card .value { font-size: 1.1rem; font-weight: 700; }
        .stat-card .value.income { color: var(--accent-green); }
        .stat-card .value.expense { color: var(--accent-red); }

        /* ---------- CATEGORY LIST CARD ---------- */
        .list-card {
            background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-card-2) 100%);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 22px 28px;
            min-height: 220px;
        }

        .list-card .list-title {
            text-align: center;
            font-weight: 600;
            font-size: 0.95rem;
            padding-bottom: 12px;
            margin-bottom: 18px;
            border-bottom: 1px solid var(--border-color);
        }

        .category-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 12px 10px;
            border-bottom: 1px solid var(--border-color);
        }

        .category-row:last-child { border-bottom: none; }

        .category-name {
            font-weight: 600;
            font-size: 0.9rem;
            flex: 1 1 auto;
        }

        .category-percentage {
            color: var(--text-secondary);
            font-size: 0.85rem;
            flex: 0 0 70px;
            text-align: center;
        }

        .category-status {
            flex: 0 0 90px;
            text-align: center;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .category-status.active { color: var(--accent-green); }
        .category-status.inactive { color: var(--accent-red); }

        .row-actions {
            display: flex;
            gap: 8px;
            flex: 0 0 auto;
        }

        .icon-btn {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            cursor: pointer;
            color: #fff;
            text-decoration: none;
        }

        .icon-btn.edit { background-color: var(--accent-blue); }
        .icon-btn.delete { background-color: var(--accent-red); }

        .empty-message {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.85rem;
            padding: 40px 0;
        }

        /* ---------- BOTTOM ACTIONS ---------- */
        .actions-row {
            display: flex;
            gap: 14px;
            justify-content: center;
            margin-top: 24px;
            flex-wrap: wrap;
        }

        .btn {
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
            border-radius: 24px;
            padding: 10px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            color: #fff;
            background-color: var(--accent-blue);
            text-decoration: none;
        }

        .btn:hover { filter: brightness(1.15); }

        .btn-crear { background-color: var(--accent-green); }

        .btn-eliminar {
            background-color: transparent;
            border: 1px solid var(--accent-red);
            color: var(--accent-red);
        }

        .btn-eliminar:hover { background-color: var(--accent-red); color: #fff; }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 1024px) {
            .stats-row { grid-template-columns: repeat(3, 1fr); }
        }

        @@media (max-width: 768px) {
            .app-layout { flex-direction: column; }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }

            .main-content { padding: 20px 16px; }
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .list-card { padding: 18px 16px; }

            .category-row { flex-wrap: wrap; }
            .category-percentage, .category-status { flex: 1 1 auto; text-align: left; }

            .actions-row { flex-direction: column; }
            .actions-row .btn { justify-content: center; width: 100%; }
        }

        @@media (max-width: 480px) {
            .stats-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="topbar">Categoria</div>

    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">🐱</div>
                <span>FinTrack</span>
                <span class="brand-toggle">&lt;&gt;</span>
            </div>

            <div class="search-box">
                <span>🔍</span>
                <input type="text" placeholder="Buscar..." />
            </div>

            <hr />

            <ul class="nav-list">
                <li><a href="#"><span class="nav-icon">🏠</span> Home</a></li>
                <li><a href="#"><span class="nav-icon">👤</span> Usuario</a></li>
                <li><a href="#"><span class="nav-icon">📋</span> Plan de Gestion</a></li>
                <li><a href="@Url.Action("Index", "Category")" class="active"><span class="nav-icon">🏷️</span> Categorias</a></li>
                <li><a href="#"><span class="nav-icon">🏦</span> Ahorros</a></li>
                <li><a href="#"><span class="nav-icon">➕</span> Ingresos</a></li>
                <li><a href="#"><span class="nav-icon">➖</span> Egresos</a></li>
            </ul>

            <hr />

            <ul class="nav-list sidebar-settings">
                <li><a href="#"><span class="nav-icon">⚙️</span> Settings</a></li>
            </ul>

            <div class="user-card">
                <div class="user-avatar">👤</div>
                <div class="user-info">
                    <span>Usuario</span>
                    <small>30x30x60</small>
                </div>
                <span class="chevron">›</span>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="page-header">
                <h1>Categorias</h1>
                <p>Gestiona la categoria.</p>
            </div>

            <section class="stats-row">
                <div class="stat-card">
                    <div class="label">Ingresos</div>
                    <div class="value income">@Model.Stats.Ingresos.ToString("$#,##0") /Mes</div>
                </div>
                <div class="stat-card">
                    <div class="label">Egresos</div>
                    <div class="value expense">@Model.Stats.Egresos.ToString("$#,##0") /Mes</div>
                </div>
                <div class="stat-card">
                    <div class="label">Plan</div>
                    <div class="value">@Model.Stats.PlanType</div>
                </div>
                <div class="stat-card">
                    <div class="label"># Egresos</div>
                    <div class="value">@Model.Stats.CantidadEgresos</div>
                </div>
            </section>

            <section class="list-card">
                <div class="list-title">Categorias con su Egreso</div>

                @if (Model.Categorias != null && Model.Categorias.Any())
                {
                    @foreach (var cat in Model.Categorias)
                    {
                        <div class="category-row">
                            <div class="category-name">@cat.CategoryName</div>
                            <div class="category-percentage">@cat.TotalEgresos.ToString("$#,##0")</div>
                            <div class="category-status @(cat.CategoryStatus ? "active" : "inactive")">
                                @(cat.CategoryStatus ? "Activa" : "Inactiva")
                            </div>
                            <div class="row-actions">
                                <a class="icon-btn edit" href="@Url.Action("Edit", "Category", new { id = cat.CategoryId })" title="Actualizar">✎</a>
                                <a class="icon-btn delete" href="@Url.Action("Delete", "Category", new { id = cat.CategoryId })" title="Eliminar">🗑</a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-message">Aún no tienes categorías creadas.</div>
                }
            </section>

            <div class="actions-row">
                <a class="btn btn-crear" href="@Url.Action("Create", "Category")">➕ Crear</a>
                <a class="btn btn-editar" href="@Url.Action("Index", "Category")">⚙️ Actualizar</a>
                <a class="btn btn-eliminar" href="@Url.Action("Index", "Category")">🗑 Eliminar</a>
            </div>
        </main>
    </div>
</body>
</html>
