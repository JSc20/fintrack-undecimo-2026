@page
@model IEnumerable<FinTrack_II_Trimestre.Models.Category>
@{
    ViewData["Title"] = "Categorias";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>Categorias - FinTrack</title>
    <style>
        :root {
            --bg-dark: #011627;
            --bg-panel: #031A2D;
            --bg-card: #1a2436;
            --bg-card-2: #16202f;
            --border-color: #253147;
            --text-primary: #FFFFFF;
            --text-secondary: #8b95a7;
            --text-muted: #6b7484;
            --accent-blue: #2b4a7a;
            --accent-green: #3ecf6e;
            --accent-red: #e0453f;
            --sidebar-active: #1e3a8a33;
            --sidebar-active-border: #3b5fd9;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .topbar {
            background-color: #05070c;
            color: var(--text-muted);
            font-size: 0.8rem;
            padding: 8px 20px;
        }

        .app-layout {
            display: flex;
            min-height: calc(100vh - 34px);
        }

        h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        font-size: 1rem;
        line-height: normal;
        letter-spacing: 0%;
        }

        /* ---------- SIDEBAR ---------- */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: var(--bg-panel);
            display: flex;
            flex-direction: column;
            padding: 20px 16px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #3ecf6e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .brand-toggle { margin-left: auto; color: var(--text-muted); font-size: 0.9rem; }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        .search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 0.85rem;
            width: 100%;
        }

        .sidebar hr {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 8px 0 14px;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .nav-list li a {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-secondary);
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: background-color 0.15s ease;
        }

        .nav-list li a:hover { background-color: #16202f; color: var(--text-primary); }

        .nav-list li a.active {
            background-color: var(--sidebar-active);
            border-left: 3px solid var(--sidebar-active-border);
            color: var(--text-primary);
            font-weight: 600;
        }

        .nav-list li a .chevron { margin-left: auto; font-size: 0.75rem; }

        .nav-icon { width: 18px; text-align: center; }

        .sidebar-settings { margin-top: 10px; }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--bg-card);
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: 16px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #2b4a7a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-card .user-info { display: flex; flex-direction: column; line-height: 1.2; }
        .user-card .user-info small { color: var(--text-muted); font-size: 0.75rem; }
        .user-card .chevron { margin-left: auto; color: var(--text-muted); }

        /* ---------- MAIN CONTENT ---------- */
        .main-content {
            font-family: 'Montserrat', sans-serif;
            flex-grow: 1;
            padding: 28px 90px;
            overflow-x: hidden;
            display: flex;
            justify-content: center;
        }

        .content-center {
            font-family: 'Montserrat', sans-serif;
            width: 100%;
            max-width: 900rem;
        }

        .content-center1 {
            font-family: 'Montserrat', sans-serif;
            width: 100%;
            padding: 30px 90px;
            max-width: 500rem;
        }

        .page-header h1 { font-size: 1.6rem; font-weight: 700; }
        .page-header p { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }

        /* ---------- STAT CARDS ---------- */
        .stats-row {
            font-family: 'Montserrat', sans-serif;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin: 36px 0 34px;
        }

        .stat-card {
            font-family: 'Montserrat', sans-serif;
            background: linear-gradient(135deg, #1A3B55 0%, #0A2031 100%);
            border-radius: 20px;
            padding: 15px 10px;
            text-align: center;
        }

        .stat-card .label { color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 6px; }
        .stat-card .value { font-size: 1.5  rem; font-weight: 700; }
        .stat-card .value.income { color: var(--accent-green); }
        .stat-card .value.expense { color: var(--accent-red); }

        /* ---------- LIST CARD ---------- */
        .list-card {
            background: linear-gradient(135deg,#1A3B55  0%, #0A2031 100%);
            border-radius: 12px;
            padding: 26px 30px;
            min-height: 340px;
            margin-bottom: 34px;
        }

        .list-title {
            text-align: center;
            font-weight: 500;
            font-size: 1.1rem;
            color: var(--text-primary);
            padding-bottom: 14px;
            margin-bottom: 18px;
            border-bottom: 1px solid var(--border-color);
        }

        .category-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            border-radius: 8px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .category-row:last-child { border-bottom: none; }
        .category-row:hover { background-color: #ffffff08; }

        .category-row.selected {
            background-color: var(--sidebar-active);
            outline: 1px solid var(--sidebar-active-border);
        }

        .category-name { font-weight: 600; font-size: 0.9rem; flex: 1 1 auto; }

        .category-percentage {
            color: var(--text-secondary);
            font-size: 0.85rem;
            flex: 0 0 80px;
            text-align: center;
        }

        .category-status {
            flex: 0 0 90px;
            text-align: center;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .category-status.active { color: var(--accent-green); }
        .category-status.inactive { color: var(--accent-red); }

        .empty-message {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.85rem;
            padding: 60px 0;
        }

        /* ---------- botones ---------- */
        .actions-row {
            display: flex;
            gap: 14px;
            justify-content: center;
            margin-top: 24px;
            flex-wrap: wrap;
        }

        .btn {
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
            border-radius: 24px;
            font-weight: 600;
            cursor: pointer;
            color: #fff;
        }

        .btn:hover { filter: brightness(1.15); }

        .btn-agregar, 
        .btn-editar, 
        .btn-eliminar { 
            background: linear-gradient(135deg, #1A3B55 0%, #0A2031 100%); 
            border-radius: 20px;
            padding: 15px 20px;
            font-size: 1.2rem;
        }

        .btn-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .btn-agregar .btn-icon { background-color: var(--accent-green); }
        .btn-editar .btn-icon { background-color: #f5c542; color: #222; }
        .btn-eliminar .btn-icon { background-color: var(--accent-red); }

        /* ---------- MODALES ---------- */
        .modal-overlay {
            font-family: 'Montserrat', sans-serif;
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(0,0,0,0.6);
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 20px;
        }

        .modal-overlay.open { display: flex; }

        .modal-box {
            font-family: 'Montserrat', sans-serif;
            width: 100%;
            max-width: 420px;
            background-color: #031A2D;
            border: 1px solid #011627;
            border-radius: 12px;
            padding: 26px 28px;
        }

        .modal-box h3 {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.2rem;
            margin-bottom: 18px;
            text-align: center;
        }

        .modal-box .form-group { margin-bottom: 16px; }

        .modal-box label {
            font-family: 'Montserrat', sans-serif;
            display: block;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .modal-box input[type="text"],
        .modal-box input[type="number"] {
            font-family: 'Montserrat', sans-serif;
            width: 100%;
            border: none;
            border-radius: 6px;
            padding: 9px 12px;
            background-color: #c9ccd2;
            font-size: 0.9rem;
            color: #222;
            outline: none;
        }

        .modal-box .checkbox-row {
            font-family: 'Montserrat', sans-serif;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .modal-footer-row {
            font-family: 'Montserrat', sans-serif;
            display: flex;
            gap: 12px;
            justify-content: center;
            margin-top: 22px;
        }

        .modal-footer-row .btn-cancelar {   
        font-family: 'Montserrat', sans-serif;
    background-color: transparent;
    border: 1px solid var(--accent-red);
    border-radius: 20px;
    color: var(--accent-red);
    padding: 10px 20px;
}

.modal-footer-row .btn-aceptarmod { 
    font-family: 'Montserrat', sans-serif;
    background: var(--accent-green);
    border-radius: 20px;
    color: var(--text-primary);
    padding: 10px 20px;
}

        .modal-error {
            font-family: 'Montserrat', sans-serif;
            color: #ff8b85;
            font-size: 0.8rem;
            margin-bottom: 10px;
            text-align: center;
        }

        .field-error {
            font-family: 'Montserrat', sans-serif;
            display: block;
            color: #ff8b85;
            font-size: 0.75rem;
            margin-top: 4px;
        }

        .delete-confirm-text {
            font-family: 'Montserrat', sans-serif;
            text-align: center;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 1024px) {
            .stats-row { grid-template-columns: repeat(3, 1fr); }
        }

        @@media (max-width: 768px) {
            .app-layout { flex-direction: column; }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }

            .main-content { padding: 20px 16px; }
            .content-center { max-width: 100%; }
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .list-card { padding: 18px 16px; }

            .category-row { flex-wrap: wrap; }
            .category-percentage, .category-status { flex: 1 1 auto; text-align: left; }

            .actions-row { flex-direction: column; }
            .actions-row .btn { justify-content: center; width: 100%; }
        }

        @@media (max-width: 480px) {
            .stats-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="topbar">Categoria</div>

    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">🐱</div>
                <span>FinTrack</span>
                <span class="brand-toggle">&lt;&gt;</span>
            </div>

            <div class="search-box">
                <span>🔍</span>
                <input type="text" placeholder="Buscar..." />
            </div>

            <hr />

            <ul class="nav-list">
                <li><a href="#"><span class="nav-icon">🏠</span> Home</a></li>
                <li><a href="#"><span class="nav-icon">👤</span> Usuario</a></li>
                <li><a href="#"><span class="nav-icon">📋</span> Plan de Gestion</a></li>
                <li>
                    <a href="@Url.Action("Index", "Category")" class="active">
                        <span class="nav-icon">🏷️</span> Categorias
                        <span class="chevron">›</span>
                    </a>
                </li>
                <li><a href="#"><span class="nav-icon">🏦</span> Ahorros</a></li>
                <li><a href="#"><span class="nav-icon">➕</span> Ingresos</a></li>
                <li><a href="#"><span class="nav-icon">➖</span> Egresos</a></li>
            </ul>

            <hr />

            <ul class="nav-list sidebar-settings">
                <li><a href="#"><span class="nav-icon">⚙️</span> Settings</a></li>
            </ul>

            <div class="user-card">
                <div class="user-avatar">👤</div>
                <div class="user-info">
                    <span>Usuario</span>
                    <small>30x30x60</small>
                </div>
                <span class="chevron">›</span>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="content-center">
            <div class="page-header">
                <h1>Categorias</h1>
                <p>Gestiona la categoria.</p>
            </div>

            <!-- Tarjetas estaticas -->
            <section class="stats-row">
                <div class="stat-card">
                    <div class="label">Ingresos</div>
                    <div class="value income">$2.400/Mes</div>
                </div>
                <div class="stat-card">
                    <div class="label">Ingresos Extra</div>
                    <div class="value income">$12.500</div>
                </div>
                <div class="stat-card">
                    <div class="label">Egresos</div>
                    <div class="value expense">$1.450/Mes</div>
                </div>
                <div class="stat-card">
                    <div class="label">Plan</div>
                    <div class="value">30x30x60</div>
                </div>
                <div class="stat-card">
                    <div class="label">Ahorro</div>
                    <div class="value income">$12.500</div>
                </div>
            </section>

            <section class="content-center1">
            <section class="list-card">
                <div class="list-title">Categorias con su Egreso</div>

                <div id="categoryList">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cat in Model)
                        {
                            <div class="category-row"
                                 data-id="@cat.CategoryId"
                                 data-nombre="@cat.CategoryName"
                                 data-porcentaje="@cat.CategoryPercentage"
                                 data-status="@(cat.CategoryStatus ? "true" : "false")">
                                <div class="category-name">@cat.CategoryName</div>
                                <div class="category-percentage">@cat.CategoryPercentage%</div>
                                <div class="category-status @(cat.CategoryStatus ? "active" : "inactive")">
                                    @(cat.CategoryStatus ? "Activa" : "Inactiva")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-message">Aún no tienes categorías creadas.</div>
                    }
                </div>
            </section>

            <div class="actions-row">
                <button type="button" class="btn btn-agregar" onclick="openModal('modalAgregar')">
                    <span class="btn-icon">+</span> Agregar
                </button>
                <button type="button" class="btn btn-editar" onclick="onEditarClick()">
                    <span class="btn-icon">✎</span> Editar
                </button>
                <button type="button" class="btn btn-eliminar" onclick="onEliminarClick()">
                    <span class="btn-icon">🗑</span> Eliminar
                </button>
            </div>
            </div>
        </section>
        </main>
    </div>

    <!-- ======= MODAL: AGREGAR ======= -->
    <div class="modal-overlay" id="modalAgregar">
        <div class="modal-box">
            <h3>Nueva Categoría</h3>
            <form method="post" asp-action="Create" asp-controller="Category">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" name="CategoryName" required />
                </div>

                <div class="form-group">
                    <label>Porcentaje (%)</label>
                    <input type="number" name="CategoryPercentage" min="0" max="100" step="0.01" required />
                </div>

                <div class="form-group checkbox-row">
                    <input type="checkbox" name="CategoryStatus" value="true" checked />
                    <label style="margin:0;">Categoría activa</label>
                </div>

                <div class="modal-footer-row">
                    <button type="button" class="btn modal-footer-row btn-cancelar" onclick="closeModal('modalAgregar')">Cancelar</button>
                    <button type="submit" class="btn btn-aceptarmod">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======= MODAL: EDITAR ======= -->
    <div class="modal-overlay" id="modalEditar">
        <div class="modal-box">
            <h3>Editar Categoría</h3>
            <form method="post" asp-action="Edit" asp-controller="Category" id="formEditar">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryId" id="editCategoryId" />

                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" name="CategoryName" id="editCategoryName" required />
                </div>

                <div class="form-group">
                    <label>Porcentaje (%)</label>
                    <input type="number" name="CategoryPercentage" id="editCategoryPercentage" min="0" max="100" step="0.01" required />
                </div>

                <div class="form-group checkbox-row">
                    <input type="checkbox" name="CategoryStatus" id="editCategoryStatus" value="true" />
                    <label style="margin:0;">Categoría activa</label>
                </div>

                <div class="modal-footer-row">
                    <button type="button" class="btn btn-cancelar" onclick="closeModal('modalEditar')">Cancelar</button>
                    <button type="submit" class="btn btn-aceptar">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======= MODAL: ELIMINAR ======= -->
    <div class="modal-overlay" id="modalEliminar">
        <div class="modal-box">
            <h3>¿Eliminar esta categoría?</h3>
            <form method="post" asp-action="DeleteConfirm" asp-controller="Category">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteCategoryId" />
                <p class="delete-confirm-text" id="deleteCategoryName">Categoría: —</p>

                <div class="modal-footer-row">
                    <button type="button" class="btn btn-cancelar" onclick="closeModal('modalEliminar')">Cancelar</button>
                    <button type="submit" class="btn btn-aceptar">Eliminar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let selectedRow = null;

        function openModal(id) {
            document.getElementById(id).classList.add('open');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.category-row').forEach(row => {
                row.addEventListener('click', function () {
                    document.querySelectorAll('.category-row').forEach(r => r.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedRow = this;
                });
            });

            // Cerrar modal al hacer click fuera del cuadro
            document.querySelectorAll('.modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) overlay.classList.remove('open');
                });
            });
        });

        function onEditarClick() {
            if (!selectedRow) {
                alert('Selecciona una categoría de la lista primero.');
                return;
            }

            document.getElementById('editCategoryId').value = selectedRow.dataset.id;
            document.getElementById('editCategoryName').value = selectedRow.dataset.nombre;
            document.getElementById('editCategoryPercentage').value = selectedRow.dataset.porcentaje;
            document.getElementById('editCategoryStatus').checked = selectedRow.dataset.status === 'true';

            openModal('modalEditar');
        }

        function onEliminarClick() {
            if (!selectedRow) {
                alert('Selecciona una categoría de la lista primero.');
                return;
            }

            document.getElementById('deleteCategoryId').value = selectedRow.dataset.id;
            document.getElementById('deleteCategoryName').textContent = 'Categoría: ' + selectedRow.dataset.nombre;

            openModal('modalEliminar');
        }
    </script>
</body>
</html>
