@model FinTrack_II_Trimestre.Models.Category

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: 70vh;">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Editar Categoría</h2>
    </div>

    <div class="ft-main-box" style="max-width: 500px;">
        <div class="text-center mb-4">
            <i class="bi bi-pencil-square" style="font-size: 3rem; color: var(--ft-text-muted);"></i>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CategoryId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center small"></div>

            <div class="mb-4 text-center">
                <label asp-for="CategoryName" class="form-label" style="color: var(--ft-text-muted);">Nombre de la Categoría</label>
                <input asp-for="CategoryName" class="form-control ft-input text-center" autocomplete="off" />
                <span asp-validation-for="CategoryName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 text-center">
                <label asp-for="CategoryPercentage" class="form-label" style="color: var(--ft-text-muted);">Porcentaje del Plan (%)</label>
                <input asp-for="CategoryPercentage" type="number" step="0.01" class="form-control ft-input text-center" />
                <span asp-validation-for="CategoryPercentage" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 form-check form-switch d-flex justify-content-center align-items-center gap-3 ps-0">
                <input asp-for="CategoryStatus" class="form-check-input ms-0 mt-0" type="checkbox" role="switch" style="background-color: #2a3a52; border-color: #2a3a52; width:3rem; height:1.5rem;">
                <label asp-for="CategoryStatus" class="form-check-label mb-0" style="color: white; font-weight: 500;">Categoría Activa</label>
            </div>

            <div class="d-flex gap-3 mt-4">
                <a asp-action="Index" class="ft-btn ft-btn-outline w-50">Cancelar</a>
                <button type="submit" class="ft-btn ft-btn-primary w-50">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}