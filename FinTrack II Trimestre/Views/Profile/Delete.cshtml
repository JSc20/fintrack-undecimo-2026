@model FinTrack_II_Trimestre.Models.Profile

@{
    ViewData["Title"] = "Eliminar Perfil";
}

<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: 70vh;">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: var(--ft-red);">¿Eliminar Cuenta?</h2>
        <p class="text-muted">Esta acción es irreversible y perderás tu información personal.</p>
    </div>

    <div class="ft-main-box text-center" style="max-width: 500px; border: 1px solid rgba(248, 81, 73, 0.3);">
        <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem; color: var(--ft-red);"></i>
        <h4 class="text-white mt-3 mb-4">Estás a punto de eliminar a:</h4>

        <div class="text-start mb-4 p-3" style="background-color: rgba(0,0,0,0.2); border-radius: 10px; border: 1px solid #2a3a52;">
            <strong style="color: var(--ft-text-muted);">Nombre:</strong> <span class="text-white">@Model.FullName</span> <br />
            <strong style="color: var(--ft-text-muted);">Correo:</strong> <span class="text-white">@Model.Email</span> <br />
            <strong style="color: var(--ft-text-muted);">Teléfono:</strong> <span class="text-white">@Model.PhoneNumber</span>
        </div>

        <form asp-action="DeleteConfirm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ProfileId" />

            <div class="d-flex flex-column gap-3">
                <button type="submit" class="ft-btn ft-btn-danger w-100">
                    <i class="bi bi-trash-fill"></i> Sí, eliminar mi perfil
                </button>
                <a asp-action="Index" class="ft-btn ft-btn-outline w-100">Cancelar y volver al perfil</a>
            </div>
        </form>
    </div>
</div>