@model FinTrack_II_Trimestre.Models.Profile

@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: 70vh;">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Editar Usuario</h2>
        <p class="text-muted">Actualiza la información de tu cuenta</p>
    </div>

    <div class="ft-main-box" style="max-width: 500px;">
        <div class="text-center mb-4"><i class="bi bi-pencil-square" style="font-size: 4rem; color: white;"></i></div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProfileId" />
            <input type="hidden" asp-for="PersonId" />
            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3 small"></div>

            <div class="mb-4 text-center">
                <label asp-for="FullName" class="form-label" style="color: var(--ft-text-muted);">Nombre Completo</label>
                <input asp-for="FullName" class="form-control ft-input text-center" />
                <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 text-center">
                <label asp-for="Age" class="form-label" style="color: var(--ft-text-muted);">Edad</label>
                <input asp-for="Age" class="form-control ft-input text-center" type="number" />
                <span asp-validation-for="Age" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 text-center">
                <label asp-for="PhoneNumber" class="form-label" style="color: var(--ft-text-muted);">Número Telefónico</label>
                <input asp-for="PhoneNumber" class="form-control ft-input text-center" type="tel" maxlength="8" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 text-center">
                <label asp-for="Email" class="form-label" style="color: var(--ft-text-muted);">Correo Electrónico</label>
                <input asp-for="Email" class="form-control ft-input text-center" type="email" />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <a asp-action="Index" class="ft-btn ft-btn-outline w-50">Cancelar</a>
                <button type="submit" class="ft-btn ft-btn-primary w-50">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}