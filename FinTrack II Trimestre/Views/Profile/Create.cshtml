@model Profile

@{
    ViewData["Title"] = "Nuevo Perfil";
}

<h1>Nuevo Perfil</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="FullName" class="form-control" placeholder="Nombre completo" />
                <label asp-for="FullName">Nombre Completo</label>
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Age" class="form-control" placeholder="Edad" />
                <label asp-for="Age">Edad</label>
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="PhoneNumber" class="form-control" placeholder="Teléfono" />
                <label asp-for="PhoneNumber">Teléfono</label>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Crear Perfil</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
