@model FinTrack_II_Trimestre.Models.BudgetPlan

@{
    ViewData["Title"] = "Eliminar Plan";
}

<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: 70vh;">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: var(--ft-red);">¿Eliminar Plan de Gestión?</h2>
    </div>

    <div class="ft-main-box text-center" style="max-width: 500px; border: 1px solid rgba(248, 81, 73, 0.3);">
        <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem; color: var(--ft-red);"></i>
        <p class="mt-3 text-white">Estás a punto de eliminar permanentemente este plan de tu historial:</p>

        <div class="text-start mb-4 p-3" style="background-color: rgba(0,0,0,0.2); border-radius: 10px; border: 1px solid #2a3a52;">
            <div class="d-flex justify-content-between mb-2">
                <span style="color: var(--ft-text-muted);">Tipo de Plan:</span>
                <span class="fw-bold" style="color: #0dcaf0;">@Model.PlanType</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span style="color: var(--ft-text-muted);">Fecha de Creación:</span>
                <span class="fw-bold text-white">@Model.CreationDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span style="color: var(--ft-text-muted);">Estado:</span>
                <span class="fw-bold @(Model.Status ? "text-success" : "text-secondary")">
                    @(Model.Status ? "Activo" : "Inactivo")
                </span>
            </div>
        </div>

        <p class="small mb-4" style="color: var(--ft-text-muted);">
            Al eliminar este plan, se borrará su registro del historial del sistema.
        </p>

        <!-- Asegúrate de que el asp-action apunte a "Delete" como lo configuramos en el controlador -->
        <form asp-action="Delete" asp-route-id="@Model.PlanId" method="post">
            @Html.AntiForgeryToken()

            <div class="d-flex gap-3 mt-4">
                <a asp-action="Index" class="ft-btn ft-btn-outline w-50">Cancelar</a>
                <button type="submit" class="ft-btn ft-btn-danger w-50">Sí, Eliminar</button>
            </div>
        </form>
    </div>
</div>