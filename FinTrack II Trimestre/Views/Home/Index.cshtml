@page
@{
    ViewData["Title"] = "Home";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>Home - FinTrack</title>
    <style>
        :root {
            --bg-dark: #011627;
            --bg-panel: #031A2D;
            --bg-card: #1a2436;
            --bg-card-2: #16202f;
            --border-color: #253147;
            --text-primary: #FFFFFF;
            --text-secondary: #8b95a7;
            --text-muted: #6b7484;
            --accent-blue: #2b4a7a;
            --accent-green: #3ecf6e;
            --accent-red: #e0453f;
            --accent-gold: #f5c542;
            --sidebar-active: #1e3a8a33;
            --sidebar-active-border: #3b5fd9;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .topbar {
            background-color: #05070c;
            color: var(--text-muted);
            font-size: 0.8rem;
            padding: 8px 20px;
        }

        .app-layout {
            display: flex;
            min-height: calc(100vh - 34px);
        }

        /* ---------- SIDEBAR ---------- */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: var(--bg-panel);
            display: flex;
            flex-direction: column;
            padding: 20px 16px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #3ecf6e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .brand-toggle { margin-left: auto; color: var(--text-muted); font-size: 0.9rem; }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        .search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 0.85rem;
            width: 100%;
        }

        .sidebar hr {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 8px 0 14px;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .nav-list li a {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-secondary);
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: background-color 0.15s ease;
        }

        .nav-list li a:hover { background-color: #16202f; color: var(--text-primary); }

        .nav-list li a.active {
            background-color: var(--sidebar-active);
            border-left: 3px solid var(--sidebar-active-border);
            color: var(--text-primary);
            font-weight: 600;
        }

        .nav-list li a .chevron { margin-left: auto; font-size: 0.75rem; }

        .nav-icon { width: 18px; text-align: center; }

        .sidebar-settings { margin-top: 10px; }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--bg-card);
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: 16px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #2b4a7a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-card .user-info { display: flex; flex-direction: column; line-height: 1.2; }
        .user-card .user-info small { color: var(--text-muted); font-size: 0.75rem; }
        .user-card .chevron { margin-left: auto; color: var(--text-muted); }

        /* ---------- MAIN CONTENT ---------- */
        .main-content {
            flex-grow: 1;
            padding: 5rem 6rem;
            overflow-x: hidden;
            display: flex;
            justify-content: center;
        }

        .content-center {
            width: 100%;
            max-width: 600rem;
        }

        .content-center1 {
            width: 100%;
            max-width: 400rem;
        }

        .page-header h1 { font-size: 1.6rem; font-weight: 700; }
        .page-header p { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }

        /* ---------- STAT CARDS ---------- */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin: 36px 0 34px;
        }

        .stat-card {
            background: linear-gradient(135deg, #1A3B55 0%, #0A2031 100%);
            border-radius: 20px;
            padding: 15px 10px;
            text-align: center;
        }

        .stat-card .label { color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 6px; }
        .stat-card .value { font-size: 1.6rem; font-weight: 700; }
        .stat-card .value.income { color: var(--accent-green); }
        .stat-card .value.expense { color: var(--accent-red); }

        /* ---------- PANELS ---------- */
        .panels-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .panel-card {
            background: linear-gradient(135deg, #1A3B55 0%, #0A2031 100%);
            border-radius: 12px;
            padding: 22px 26px;
            display: flex;
            flex-direction: column;
        }

        .panel-title {
            font-size: 0.9rem;
            color: var(--text-secondary);
            padding-bottom: 10px;
            margin-bottom: 6px;
            border-bottom: 1px solid var(--border-color);
        }

        .panel-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 4px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.92rem;
        }

        .panel-row:last-of-type { border-bottom: none; }

        .panel-row.total {
            font-weight: 700;
            margin-top: 6px;
            border-top: 1px solid var(--border-color);
            border-bottom: none;
        }

        .panel-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin: 18px 0 6px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-color);
        }

        .panel-row-foot {
            background: linear-gradient(135deg, #224d6e 0%, #020508 100%);
            border-radius: 10px;
            padding: 10px 14px;
            margin-top: 10px;
        }

        .panel-box{            
            background: linear-gradient(135deg, #224d6e 0%, #020508 100%);
            border-radius: 10px;
            padding: 10px 14px;
            margin-top: 10px;
        }

        .value-green { color: var(--accent-green); font-weight: 700; }
        .value-gold { color: var(--accent-gold); font-weight: 700; }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 1024px) {
            .stats-row { grid-template-columns: repeat(3, 1fr); }
            .panels-row { grid-template-columns: 1fr; }
        }

        @@media (max-width: 768px) {
            .app-layout { flex-direction: column; }
            .sidebar { width: 100%; border-bottom: 1px solid var(--border-color); }
            .main-content { padding: 20px 16px; }
            .content-center { max-width: 100%; }
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .panel-card { padding: 18px 16px; }
        }

        @@media (max-width: 480px) {
            .stats-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="topbar">Página Principal</div>

    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">🐱</div>
                <span>FinTrack</span>
                <span class="brand-toggle">&lt;&gt;</span>
            </div>

            <div class="search-box">
                <span>🔍</span>
                <input type="text" placeholder="Buscar..." />
            </div>

            <hr />

            <ul class="nav-list">
                <li>
                    <a href="@Url.Action("Index", "Home")" class="active">
                        <span class="nav-icon">🏠</span> Home <i class="bi bi-house-door"></i>
                        <span class="chevron">›</span>
                    </a>
                </li>
                <li><a href="#"><span class="nav-icon">📋</span> Plan de Gestion</a></li> <i class="bi bi-person-fill"></i>
                <li><a href="#"><span class="nav-icon">🏷️</span> Categorias</a></li>
                <li><a href="#"><span class="nav-icon">🏦</span> Ahorros</a></li>   
                <li><a href="#"><span class="nav-icon">➕</span> Ingresos</a></li>
                <li><a href="#"><span class="nav-icon">➖</span> Egresos</a></li>
            </ul>

            <hr />

            <ul class="nav-list sidebar-settings">
                <li><a href="#"><span class="nav-icon">⚙️</span> Settings</a></li>
            </ul>

            <div class="user-card">
                <div class="user-avatar">👤</div>
                <div class="user-info">
                    <span>Usuario</span>
                    <small>30x30x60</small>
                </div>
                <span class="chevron">›</span>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="content-center">
                <div class="page-header">
                    <h1>Bienvenido, Usuario</h1>
                    <p>Mide tus estadísticas todo en un solo lugar.</p>
                </div>

                <!-- Tarjetas estaticas -->
                <section class="stats-row">
                    <div class="stat-card">
                        <div class="label">Ingresos</div>
                        <div class="value income">$2.400/Mes</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Ingresos Extra</div>
                        <div class="value income">$12.500</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Egresos</div>
                        <div class="value expense">$1.450/Mes</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Plan</div>
                        <div class="value">30x30x60</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Ahorro</div>
                        <div class="value income">$12.500</div>
                    </div>
                </section>

                <section class="content-center1">
                <section class="panels-row">
                    <!-- PRESUPUESTOS -->
                    <div class="panel-card">
                        <div class="panel-title">Presupuestos</div>

                        <div class="panel-row"><span>Agua</span><span>400</span></div>
                        <div class="panel-row"><span>Luz</span><span>100</span></div>
                        <div class="panel-row"><span>Comida</span><span>400</span></div>
                        <div class="panel-row"><span>Viaje</span><span>300</span></div>
                        <div class="panel-row"><span>Escuela</span><span>100</span></div>

                        <div class="panel-box">
                        <div class="panel-row total">
                            <span>Total</span>
                            <span>1300</span>
                        </div>
                    </div>
                    </div>

                    <!-- DISTRIBUCION + AHORRO -->
                    <div class="panel-card">
                        <div class="panel-title">Distribución</div>

                        <div class="panel-row"><span>Gastos Fijos</span><span>50%</span></div>
                        <div class="panel-row"><span>Ahorro</span><span>20%</span></div>
                        <div class="panel-row"><span>Ocio</span><span>10%</span></div>
                        <div class="panel-row"><span>Inversiones</span><span>20%</span></div>
                        <div class="panel-row"><span>Ultima Modificacion</span><span>04-11-2026</span></div>

                        <div class="panel-subtitle">Ahorro</div>

                        <div class="panel-row-foot">
                        <div class="panel-row">
                            <span>Monto Actual:</span>
                            <span class="value-green">$12.500</span>
                        </div>
                        <div class="panel-row">
                            <span>Meta de Ahorro:</span>
                            <span class="value-gold">$32.000</span>
                        </div>
                        </div>
                    </div>
                </section>
            </section>
            </div>
        </main>
    </div>
</body>
</html>
