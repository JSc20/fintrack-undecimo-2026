@model /*FinTrack_II_Trimestre.Models.Home   don´t know where to put this*/
@{
    ViewData["Title"] = "Página Principal";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página Principal - FinTrack</title>
    <style>
        :root {
            --bg-dark: #0b0f1a;
            --bg-panel: #101828;
            --bg-card: #1a2436;
            --bg-card-2: #16202f;
            --border-color: #253147;
            --text-primary: #e8ecf3;
            --text-secondary: #8b95a7;
            --text-muted: #6b7484;
            --accent-blue: #2b4a7a;
            --accent-green: #3ecf6e;
            --accent-red: #e0453f;
            --accent-yellow: #e8c547;
            --sidebar-active: #1e3a8a33;
            --sidebar-active-border: #3b5fd9;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .topbar {
            background-color: #05070c;
            color: var(--text-muted);
            font-size: 0.8rem;
            padding: 8px 20px;
        }

        .app-layout {
            display: flex;
            min-height: calc(100vh - 34px);
        }

        /* ---------- SIDEBAR ---------- */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: var(--bg-panel);
            display: flex;
            flex-direction: column;
            padding: 20px 16px;
            border-right: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #3ecf6e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .brand-toggle { margin-left: auto; color: var(--text-muted); font-size: 0.9rem; }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

        .search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 0.85rem;
            width: 100%;
        }

        .sidebar hr {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 8px 0 14px;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .nav-list li a {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-secondary);
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: background-color 0.15s ease;
        }

        .nav-list li a:hover { background-color: #16202f; color: var(--text-primary); }

        .nav-list li a.active {
            background-color: var(--sidebar-active);
            border-left: 3px solid var(--sidebar-active-border);
            color: var(--text-primary);
            font-weight: 600;
        }

        .nav-icon { width: 18px; text-align: center; }

        .sidebar-settings { margin-top: 10px; }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--bg-card);
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: 16px;
            text-decoration: none;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #2b4a7a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-card .user-info { display: flex; flex-direction: column; line-height: 1.2; }
        .user-card .user-info small { color: var(--text-muted); font-size: 0.75rem; }
        .user-card .chevron { margin-left: auto; color: var(--text-muted); }

        /* ---------- MAIN CONTENT ---------- */
        .main-content {
            flex-grow: 1;
            padding: 28px 32px;
            overflow-x: hidden;
        }

        .page-header h1 { font-size: 1.6rem; font-weight: 700; }
        .page-header p { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }

        /* ---------- STAT CARDS ---------- */
        .stats-row {
            display: flex;
            gap: 14px;
            margin-top: 26px;
            flex-wrap: wrap;
        }

        .stat-card {
            flex: 1 1 160px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 16px;
            text-align: center;
        }

        .stat-card .label { color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 8px; }
        .stat-card .value { font-size: 1.2rem; font-weight: 700; }
        .stat-card .value.green { color: var(--accent-green); }
        .stat-card .value.red { color: var(--accent-red); }

        /* ---------- CONTENT GRID ---------- */
        .content-grid {
            display: flex;
            gap: 24px;
            margin-top: 24px;
            flex-wrap: wrap;
        }

        .panel {
            flex: 1 1 400px;
            background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-card-2) 100%);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
        }

        .panel-title {
            font-size: 0.85rem;
            color: var(--text-secondary);
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 6px;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 10px;
            font-size: 0.9rem;
            border-radius: 6px;
        }

        .data-row:nth-child(odd) { background-color: var(--bg-card); }
        .data-row:nth-child(even) { background-color: var(--bg-card-2); }

        .data-row.indent { padding-left: 24px; }
        .data-row.indent2 { padding-left: 36px; }

        .data-row.total {
            font-weight: 700;
            margin-top: 24px;
            background-color: var(--bg-card-2);
        }

        .sub-title {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin: 20px 0 6px;
            padding-bottom: 6px;
            border-bottom: 1px solid var(--border-color);
        }

        .value-yellow { color: var(--accent-yellow); }

        /* ---------- SHORTCUTS ---------- */
        .shortcuts { text-align: center; margin-top: 30px; }

        .shortcuts .title {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 12px;
        }

        .shortcuts-buttons {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn {
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
            border-radius: 24px;
            padding: 10px 22px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            color: #fff;
            background-color: var(--accent-blue);
            text-decoration: none;
        }

        .btn:hover { filter: brightness(1.15); }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 900px) {
            .content-grid { flex-direction: column; }
        }

        @@media (max-width: 768px) {
            .app-layout { flex-direction: column; }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }

            .main-content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
    <div class="topbar">Página Principal</div>

    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">🐱</div>
                <span>FinTrack</span>
                <span class="brand-toggle">&lt;&gt;</span>
            </div>

            <div class="search-box">
                <span>🔍</span>
                <input type="text" placeholder="Buscar..." />
            </div>

            <hr />

            <ul class="nav-list">
                <li><a href="@Url.Action("Index", "Home")" class="active"><span class="nav-icon">🏠</span> Home</a></li>
                <li><a href="@Url.Action("Index", "Profile")"><span class="nav-icon">👤</span> Usuario</a></li>
                <li><a href="#"><span class="nav-icon">📋</span> Plan de Gestion</a></li>
                <li><a href="#"><span class="nav-icon">🏷️</span> Categorias</a></li>
                <li><a href="#"><span class="nav-icon">🏦</span> Ahorros</a></li>
                <li><a href="#"><span class="nav-icon">➕</span> Ingresos</a></li>
                <li><a href="#"><span class="nav-icon">➖</span> Egresos</a></li>
            </ul>

            <hr />

            <ul class="nav-list sidebar-settings">
                <li><a href="#"><span class="nav-icon">⚙️</span> Settings</a></li>
            </ul>

            <a href="@Url.Action("Index", "Profile")" class="user-card">
                <div class="user-avatar">👤</div>
                <div class="user-info">
                    <span>@Model.NombreUsuario</span>
                    <small>@Model.Plan</small>
                </div>
                <span class="chevron">›</span>
            </a>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <div class="page-header">
                <h1>Bienvenido, @Model.NombreUsuario</h1>
                <p>Mide tus estadísticas todo en un solo lugar.</p>
            </div>

            <!-- STAT CARDS -->
            <div class="stats-row">
                <div class="stat-card">
                    <div class="label">Ingresos</div>
                    <div class="value green">@Model.Ingresos.ToString("C0")/Mes</div>
                </div>
                <div class="stat-card">
                    <div class="label">Egresos</div>
                    <div class="value red">@Model.Egresos.ToString("C0")/Mes</div>
                </div>
                <div class="stat-card">
                    <div class="label">Plan</div>
                    <div class="value">@Model.Plan</div>
                </div>
                <div class="stat-card">
                    <div class="label"># Egresos</div>
                    <div class="value">@Model.NumeroEgresos</div>
                </div>
                <div class="stat-card">
                    <div class="label">Ahorro</div>
                    <div class="value green">@Model.MontoAhorro.ToString("C0")</div>
                </div>
            </div>

            <!-- CONTENT GRID -->
            <div class="content-grid">

                <!-- Presupuestos -->
                <div class="panel">
                    <div class="panel-title">Presupuestos</div>
                    @foreach (var item in Model.Presupuestos)
                    {
                        <div class="data-row"><span>@item.Nombre</span><span>@item.Monto</span></div>
                    }
                    <div class="data-row total"><span>Total</span><span>@Model.TotalPresupuesto</span></div>
                </div>

                <!-- Distribucion -->
                <div class="panel">
                    <div class="panel-title">Distribución</div>
                    <div class="data-row"><span>Gastos Fijos</span><span>@Model.PorcentajeGastosFijos%</span></div>
                    <div class="data-row indent"><span>Ahorro</span><span>@Model.PorcentajeAhorro%</span></div>
                    <div class="data-row indent2"><span>Ocio</span><span>@Model.PorcentajeOcio%</span></div>
                    <div class="data-row"><span>Inversiones</span><span>@Model.PorcentajeInversiones%</span></div>
                    <div class="data-row"><span>Ultima Modificacion</span><span>@Model.UltimaModificacion.ToString("dd-MM-yyyy")</span></div>

                    <div class="sub-title">Ahorro</div>
                    <div class="data-row"><span>Monto Actual:</span><span class="value-yellow">@Model.MontoAhorro.ToString("C0")</span></div>
                    <div class="data-row"><span>Meta de Ahorro:</span><span class="value-yellow">@Model.MetaAhorro.ToString("C0")</span></div>
                </div>

            </div>

            <!-- SHORTCUTS -->
            <div class="shortcuts">
                <div class="title">Shortcuts</div>
                <div class="shortcuts-buttons">
                    <a class="btn" href="@Url.Action("Edit", "Ingresos")">✏️ Editar Ingresos</a>
                    <a class="btn" href="@Url.Action("Edit", "Egresos")">✏️ Editar Egresos</a>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
